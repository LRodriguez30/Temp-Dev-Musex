{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Musex",
  "version": "0.1.0",
  "identifier": "com.lart.musex",

  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/musex/browser"
  },

  "app": {
    "windows": [
      {
        "title": "Musex",

        "width": 1280,
        "height": 800,

        "minWidth": 500,
        "minHeight": 500
      }
    ],

    "security": {
      "csp": null,

      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Desktop/Musex/covers/**"
        ]
      }
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "externalBin": [
      "binaries/yt-dlp"
    ]
  }
}