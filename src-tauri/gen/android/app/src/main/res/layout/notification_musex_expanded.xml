<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="150dp"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/musex_notification_background">

    <TextView
        android:id="@+id/notification_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="REPRODUCIENDO"
        android:textColor="#9CFF00"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nombre de canción"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notification_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Artista"
        android:textColor="#B0B3B8"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/notification_previous"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:padding="13dp"
            android:src="@android:drawable/ic_media_previous"
            android:scaleType="fitCenter"
            android:contentDescription="Anterior"
            android:background="@android:color/transparent" />

        <ImageView
            android:id="@+id/notification_play"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:padding="15dp"
            android:src="@android:drawable/ic_media_play"
            android:scaleType="fitCenter"
            android:contentDescription="Reproducir o pausar"
            android:background="@drawable/musex_play_button" />

        <ImageView
            android:id="@+id/notification_next"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:padding="13dp"
            android:src="@android:drawable/ic_media_next"
            android:scaleType="fitCenter"
            android:contentDescription="Siguiente"
            android:background="@android:color/transparent" />

    </LinearLayout>

</LinearLayout>