<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="88dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:background="@drawable/musex_notification_background">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de canción"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notification_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Artista"
            android:textColor="#B0B3B8"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notification_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MUSEX"
            android:textColor="#9CFF00"
            android:textSize="10sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ImageView
        android:id="@+id/notification_previous"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_previous"
        android:scaleType="fitCenter"
        android:contentDescription="Anterior"
        android:background="@android:color/transparent" />

    <ImageView
        android:id="@+id/notification_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_media_play"
        android:scaleType="fitCenter"
        android:contentDescription="Reproducir o pausar"
        android:background="@drawable/musex_play_button" />

    <ImageView
        android:id="@+id/notification_next"
        android:layout_width="36dp"
        android:layout_height="44dp"
        android:padding="8dp"
        android:src="@android:drawable/ic_media_next"
        android:scaleType="fitCenter"
        android:contentDescription="Siguiente"
        android:background="@android:color/transparent" />

</LinearLayout>